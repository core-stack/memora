{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      { "include": "**/*.hbs", "outDir": "dist" },
      {
        "include": "./@generated",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
