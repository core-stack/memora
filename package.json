{
  "name": "snipet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "generate:prompts": "cd apps/backend && npm run generate:prompts",
    "generate:api": "cd apps/frontend && npm run generate:api",

    "db:generate": "cd apps/backend && pnpm db:generate",
    "db:migrate": "cd apps/backend && pnpm typeorm migration:run",
    "db:migrate:prod": "cd apps/backend && npm run typeorm migration:run",

    "start:frontend": "turbo run start --filter=@snipet/frontend",
    "start:backend": "turbo run start --filter=@snipet/backend",
    "start:prod": "cd apps/backend && npm run start:prod",
    
    "dev": "turbo dev",
    "dev:frontend": "turbo run dev --filter=@snipet/frontend",
    "dev:backend": "turbo run dev --filter=@snipet/backend",
    "dev:schemas": "turbo run dev --filter=@snipet/schemas",
    
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@snipet/frontend",
    "build:backend": "turbo run build --filter=@snipet/backend",
    "build:schemas": "turbo run build --filter=@snipet/schemas",
    
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
